# Copie para .env e preencha com seus valores locais
# No Render, configure estas variáveis em Environment (Dashboard)

# PostgreSQL no Render — use o Internal Hostname (termina em -a)
# Formato: jdbc:postgresql://HOST_INTERNO:5432/NOME_DO_BANCO
DB_URL=jdbc:postgresql://dpg-d8kvr9ugvqtc73ad819g-a:5432/biblioteca_5ihl
DB_USERNAME=biblioteca
DB_PASSWORD=cole_a_senha_do_dashboard_render

# Porta (Render injeta PORT automaticamente)
PORT=8080

# JWT — gere com: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
JWT_SECRET=sua_chave_base64url_aqui
JWT_EXPIRATION=86400000

# Gmail — use Senha de App (não a senha normal da conta)
MAIL_USERNAME=seu@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_DESTINATARIOS=seu@gmail.com

SPRING_PROFILES_ACTIVE=prod
