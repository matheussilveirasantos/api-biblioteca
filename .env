# Banco de Dados (Render preenche DATABASE_URL automaticamente se você linkar o banco)
DATABASE_URL=jdbc:postgresql://HOST:5432/DBNAME
DB_USERNAME=biblioteca
DB_PASSWORD=troque_por_senha_segura

# Servidor
PORT=8080

# JWT
JWT_SECRET=troque_por_uma_chave_segura_em_producao
JWT_EXPIRATION=86400000

# E-mail (SMTP Gmail)
MAIL_USERNAME=seuemail@gmail.com
MAIL_PASSWORD=sua_senha_de_app_gmail
EMAIL_DESTINATARIO=admin@suaempresa.com

# CORS - URL do seu frontend React (ex: https://meu-app.vercel.app)
